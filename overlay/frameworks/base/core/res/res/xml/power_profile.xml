<device name="Android">
  <!-- Most values are the incremental current used by a feature,
       in mA (measured at nominal voltage). -->
  <item name="none">0</item>
  <item name="screen.on">63</item>
  <item name="screen.full">261</item>
  <item name="bluetooth.active">25.2</item>
  <item name="bluetooth.on">1.8</item>
  <item name="wifi.on">1.14</item>
  <item name="wifi.active">74</item>
  <item name="wifi.scan">54</item>
  <item name="dsp.audio">10.8</item>
  <item name="dsp.video">39.6</item>
  <item name="radio.active">191.16</item>
  <item name="radio.scanning">82.8</item>
  <item name="gps.on">50.4</item>
  <!-- Current consumed by the radio at different signal strengths, when paging -->
  <array name="radio.on">
      <value>2.88</value>
      <value>2.88</value>
  </array>

  <!-- A list of heterogeneous CPU clusters, where the value for each cluster represents the
       number of CPU cores for that cluster. -->
  <array name="cpu.clusters.cores">
      <value>4</value>
  </array>

    <!-- Different CPU speeds for cluster 0 as reported in
       /sys/devices/system/cpu/cpu0/cpufreq/stats/time_in_state. -->
  <array name="cpu.speeds.cluster0">
      <value>200000</value>
      <value>400000</value>
      <value>533333</value>
      <value>800000</value>
      <value>998400</value>
      <value>1094400</value>
      <value>1190400</value>
  </array>

  <!-- Current at each CPU speed for cluster 0, as per 'cpu.speeds.cluster0'.
       Like cpu.speeds.cluster0, there must be one of these present for
       each heterogeneous CPU cluster. -->
  <array name="cpu.active.cluster0">
      <value>15.01</value>
      <value>25.64</value>
      <value>37.62</value>
      <value>50.61</value>
      <value>88.26</value>
      <value>96.32</value>
  </array>

  <!-- Current when CPU is idle -->
  <item name="cpu.idle">2.3</item>

  <!-- This is the battery capacity in mAh (measured at nominal voltage) -->
  <item name="battery.capacity">7000</item>

  <array name="wifi.batchedscan"> <!-- mA -->
      <value>.0002</value>
      <value>.002</value>
      <value>.02</value>
      <value>.2</value>
      <value>2</value>
  </array>
</device>
